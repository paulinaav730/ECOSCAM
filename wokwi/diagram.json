  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot1:SIG", "esp:D34", "green", [ "v0" ] ],
    [ "btnPrimary:1.l", "esp:GND.1", "black", [ "v0" ] ],
    [ "btnPrimary:2.r", "esp:D14", "green", [ "v0" ] ],
    [ "btnSecondary:1.l", "esp:GND.1", "black", [ "v0" ] ],
    [ "btnSecondary:2.r", "esp:D27", "blue", [ "v0" ] ],
    [ "ledGreen:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "ledGreen:A", "esp:D26", "limegreen", [ "v0" ] ],
    [ "ledRed:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "ledRed:A", "esp:D25", "red", [ "v0" ] ]
  ],
  "dependencies": {}
