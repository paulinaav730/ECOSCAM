{
  "version": 1,
  "author": "ECOSCAM - Eco World Colombia",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": -40,
      "left": -150,
      "attrs": { "value": "2048" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnPrimary",
      "top": 80,
      "left": -150,
      "attrs": { "color": "green", "label": "Recoger / Clasificar" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnSecondary",
      "top": 150,
      "left": -150,
      "attrs": { "color": "blue", "label": "Cambiar Eje X/Y" }
    },
    {
      "type": "wokwi-led",
      "id": "ledGreen",
      "top": -40,
      "left": 150,
      "attrs": { "color": "limegreen", "label": "Acierto" }
    },
    {
      "type": "wokwi-led",
      "id": "ledRed",
      "top": 20,
      "left": 150,
      "attrs": { "color": "red", "label": "Error" }
