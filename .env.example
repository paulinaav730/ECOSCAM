# ==============================================================================
# EcoScan Colombia — Variables de Entorno (.env.example)
# Copia este archivo como .env.local para desarrollo local o configura estas
# variables en el panel de Vercel para producción.
# NUNCA incluyas claves reales en este archivo ni en el repositorio Git.
# ==============================================================================

# 1. Supabase (Base de datos PostgreSQL, Auth y Storage)
# Obtén estos valores en: Project Settings -> API en tu panel de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica_aqui

# Clave privilegiada de servidor (OPCIONAL: solo para operaciones administrativas de servidor cuando RLS requiera bypass controlado)
# NUNCA uses el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_privada_aqui

# 2. Proveedor de Inteligencia Artificial (Google Gemini API - @google/genai)
# Clave privada de servidor para análisis de imágenes con gemini-3.8-flash (Interactions API).
# Si no se configura, EcoScan desactiva el análisis visual simulado y mantiene el catálogo y motor de reglas 100% operativos.
GEMINI_API_KEY=tu_gemini_api_key_privada_aqui

# 3. Configuración de la aplicación
NEXT_PUBLIC_DEFAULT_MUNICIPALITY=Medellín
NEXT_PUBLIC_APP_URL=http://localhost:3000
